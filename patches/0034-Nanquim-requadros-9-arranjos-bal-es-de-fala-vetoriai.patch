+// capítulo: pilha de páginas com a capa, nome e número de páginas
+class ChapterDelegate : public QStyledItemDelegate
+{
+public:
+    using QStyledItemDelegate::QStyledItemDelegate;
+    static QSize cell() { return QSize(170, 236); }
+    QSize sizeHint(const QStyleOptionViewItem &, const QModelIndex &) const override { return cell(); }
+    void paint(QPainter *g, const QStyleOptionViewItem &option, const QModelIndex &index) const override
+    {
+        g->save();
+        g->setRenderHint(QPainter::Antialiasing);
+        g->setRenderHint(QPainter::SmoothPixmapTransform);
+        const QRect r = option.rect.adjusted(12, 8, -12, -8);
+        const int pw = r.width() - 10;
+        const int ph = qRound(pw / 0.707);
+        const QRect paper(r.left(), r.top() + 8, pw, ph);
+        const bool isNew = index.data(Qt::UserRole + 1).toString().isEmpty();
+        if (isNew) {
+            QPen dash(QColor(0x4a, 0x4a, 0x55), 2, Qt::DashLine);
+            g->setPen(dash);
+            g->setBrush(QColor(0x1c, 0x1c, 0x21));
+            g->drawRoundedRect(paper, 10, 10);
+            g->setPen(QPen(C_ACCENT, 3, Qt::SolidLine, Qt::RoundCap));
+            const QPointF c = paper.center();

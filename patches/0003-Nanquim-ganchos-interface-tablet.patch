+namespace {
+// Nanquim: abrir um pincel (.kpp) ou pacote (.bundle) instala o recurso,
+// em vez de tentar abri-lo como imagem. Usado quando o arquivo chega pelo
+// "Abrir com" do Android ou pela linha de comando.
+bool nanquimImportResourceFile(QWidget *parent, const QString &url)
+{
+    QString path = url;
+    if (path.startsWith(QStringLiteral("file://"))) {
+        path = QUrl(path).toLocalFile();
+    }
+    const QFileInfo info(path);
+    const QString suffix = info.suffix().toLower();
+    if (suffix != QStringLiteral("kpp") && suffix != QStringLiteral("bundle") && suffix != QStringLiteral("sut") && suffix != QStringLiteral("zip")) {
+        return false;
+    }
+    if (!info.exists()) {
+        return false;
+    }
+
+    // Nunca abrir diálogos durante a inicialização: no Android isso trava o
+    // app na tela de abertura. Importamos depois que a janela aparece.
+    QPointer<QWidget> parentPtr(parent);
+    QTimer::singleShot(1500, qApp, [parentPtr, path, suffix, info]() {
+        QWidget *parent = parentPtr.data();
+        if (KisApplication *app = qobject_cast<KisApplication*>(qApp)) {
+            app->hideSplashScreen();
+        }
+
+    if (suffix == QStringLiteral("zip")) {
+        QString text;
+        NanquimSutImport::importZipArchive(parent, path, &text);
+        QMessageBox::information(parent, QStringLiteral("Nanquim"), text);
+        return;
+    }
+
+    if (suffix == QStringLiteral("sut")) {
+        QString text;
+        NanquimSutImport::importFile(parent, path, &text);
+        QMessageBox::information(parent, QStringLiteral("Nanquim"), text);
+        return;
+    }
+
+    if (suffix == QStringLiteral("kpp")) {
+        KoResourceSP resource = KisResourceUserOperations::importResourceFileWithUserInput(
+            parent, QString(), ResourceType::PaintOpPresets, path);
+        if (resource) {
+            // a janela de pincéis abre na etiqueta "Nanquim": o pincel importado entra nela,
+            // senão ele só apareceria em "Tudo" e pareceria que a importação falhou
+            bool tagged = false;
+            KisTagModel tagModel(ResourceType::PaintOpPresets);
+            KisTagSP tag = tagModel.tagForUrl(QStringLiteral("Nanquim"));
+            if (tag && resource->resourceId() >= 0) {
+                KisTagResourceModel tagResourceModel(ResourceType::PaintOpPresets);
+                tagged = tagResourceModel.tagResources(tag, QVector<int>() << resource->resourceId());
+            }
+            QMessageBox::information(parent, QStringLiteral("Nanquim"),
+                                     tagged ? QStringLiteral("Pincel importado: %1\nEle já está na etiqueta \"Nanquim\" da janela de pincéis.").arg(resource->name())
+                                            : QStringLiteral("Pincel importado: %1\nEle está em \"Tudo\", na janela de pincéis.").arg(resource->name()));
+        }
+        KisUsageLogger::log(QStringLiteral("[Nanquim] Import .kpp %1: %2").arg(info.fileName()).arg(resource ? "ok" : "falhou"));
+        return;
+    }
+
+    const bool ok = KisStorageModel::instance()->importStorage(path, KisStorageModel::None);
+    QMessageBox::information(parent, QStringLiteral("Nanquim"),
+                             ok ? QStringLiteral("Pacote importado: %1\nOs pincéis estão em \"Tudo\", na janela de pincéis.").arg(info.fileName())
+                                : QStringLiteral("Não foi possível importar %1.\nTalvez ele já esteja instalado, ou o arquivo não é um pacote do Krita válido.").arg(info.fileName()));
+    KisUsageLogger::log(QStringLiteral("[Nanquim] Import .bundle %1: %2").arg(info.fileName()).arg(ok ? "ok" : "falhou"));
+    });
+    return true;
+}
+}
+
+// usado pela janela de pincéis do Nanquim ("Importar pincéis")
+bool nanquimImportResourcePublic(QWidget *parent, const QString &url)
+{
+    return nanquimImportResourceFile(parent, url);
+}

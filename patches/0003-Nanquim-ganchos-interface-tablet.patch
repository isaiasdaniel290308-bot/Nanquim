diff --git a/libs/ui/KisUiFont.cpp b/libs/ui/KisUiFont.cpp
index b866d9dd94..67ceaee488 100644
--- a/libs/ui/KisUiFont.cpp
+++ b/libs/ui/KisUiFont.cpp
@@ -85,6 +85,36 @@ QFont normalFont()
         font = *userFont;
     } else {
         font = systemDefaultUiFont();
+#ifdef Q_OS_ANDROID
+        // Nanquim: fonte da interface embutida no APK. O CI baixa a Satoshi
+        // (Fontshare, ITF Free Font License) para ui-*.otf; se não conseguir,
+        // copia a Montserrat (SIL OFL) para os mesmos nomes. O nome da família
+        // vem do próprio arquivo, então serve qualquer uma das duas.
+        static bool s_registered = false;
+        static QString s_family;
+        if (!s_registered) {
+            s_registered = true;
+            for (const char *w : {"regular", "medium", "bold"}) {
+                const int id = QFontDatabase::addApplicationFont(
+                            QStringLiteral(":/splash/fonts/ui-%1.otf").arg(QLatin1String(w)));
+                if (id >= 0 && s_family.isEmpty()) {
+                    const QStringList families = QFontDatabase::applicationFontFamilies(id);
+                    if (!families.isEmpty()) {
+                        s_family = families.first();
+                    }
+                }
+            }
+            // a Montserrat continua no pacote (balões de texto usam por nome)
+            for (const char *w : {"Regular", "Medium", "SemiBold", "Bold"}) {
+                QFontDatabase::addApplicationFont(QStringLiteral(":/splash/fonts/Montserrat-%1.ttf")
+                                                  .arg(QLatin1String(w)));
+            }
+            if (s_family.isEmpty()) {
+                s_family = QStringLiteral("Montserrat");
+            }
+        }
+        font.setFamily(s_family);
+#endif
     }
 #ifdef Q_OS_WIN
     // XXX: Forces Qt to use full hinting for UI text, otherwise the default

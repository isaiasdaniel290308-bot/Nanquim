@@ -1710,10 +1691,19 @@ QWidget *buildGallery(KisMainWindow *mw)
     recents->setFocusPolicy(Qt::NoFocus);
     recents->setMouseTracking(false);
     KisKineticScroller::createPreconfiguredScroller(recents);
-    RecentLongPress *longPress = new RecentLongPress(mw, recents);
-    QObject::connect(recents, &QListView::clicked, mw, [mw, longPress](const QModelIndex &index) {
-        if (longPress->swallowClick()) return;
+    QObject::connect(removeMode, &QPushButton::toggled, recents, [recents, removeMode, hint](bool on) {
+        removeMode->setText(on ? i18n("Concluir") : i18n("Remover desenhos"));
+        hint->setVisible(on);
+        recents->setProperty("nanquimRemoveMode", on);
+        recents->viewport()->update();
+    });
+    QObject::connect(recents, &QListView::clicked, mw, [mw, recents, removeMode](const QModelIndex &index) {
         const QString path = index.data(Qt::ToolTipRole).toString();
+        if (removeMode->isChecked()) {
+            // só tira da lista; o arquivo continua no armazenamento
+            if (!path.isEmpty()) mw->removeRecentFile(path);
+            return;
+        }
         if (!path.isEmpty()) {
             mw->openDocument(path, KisMainWindow::None);
         }

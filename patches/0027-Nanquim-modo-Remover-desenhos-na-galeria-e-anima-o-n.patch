     const char *detail;
@@ -1684,9 +1659,15 @@ QWidget *buildGallery(KisMainWindow *mw)
     QHBoxLayout *recentsHead = new QHBoxLayout();
     recentsHead->addWidget(sectionLabel(i18n("Recentes"), body));
     recentsHead->addStretch(1);

+++ b/libs/global/NanquimStepTimer.h
@@ -0,0 +1,49 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 Nanquim
+ *
+ *  SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#ifndef NANQUIM_STEP_TIMER_H
+#define NANQUIM_STEP_TIMER_H
+
+#include <QElapsedTimer>
+#include <QString>
+
+#include "KisUsageLogger.h"
+
+/**
+ * Nanquim: cronômetro de etapas. Cada mark() escreve no log do Krita
+ * ("[Nanquim tempo] <prefixo>: <etapa> - N ms") o tempo desde a marca anterior.
+ * Só registra no Android; no desktop não faz nada.
+ */
+class NanquimStepTimer
+{
+public:
+    explicit NanquimStepTimer(const QString &prefix)
+        : m_prefix(prefix)
+    {
+        m_timer.start();
+    }
+
+    // minMs: só registra etapas que levaram pelo menos isso (evita poluir o log)
+    void mark(const QString &step, qint64 minMs = 0)
+    {
+        const qint64 ms = m_timer.restart();
+#ifdef Q_OS_ANDROID
+        if (ms >= minMs) {
+            KisUsageLogger::log(QStringLiteral("[Nanquim tempo] %1: %2 - %3 ms").arg(m_prefix, step).arg(ms));
+        }
+#else
+        Q_UNUSED(step);
+        Q_UNUSED(minMs);
+        Q_UNUSED(ms);
+#endif
+    }
+
+private:
+    QString m_prefix;
+    QElapsedTimer m_timer;
+};
+
+#endif
diff --git a/libs/image/kis_image_config.cpp b/libs/image/kis_image_config.cpp
index eba8c3c..2a46689 100644
--- a/libs/image/kis_image_config.cpp
+++ b/libs/image/kis_image_config.cpp
@@ -194,8 +194,16 @@ int KisImageConfig::poolLimit() const
 
 qreal KisImageConfig::memoryHardLimitPercent(bool requestDefault) const
 {
+#ifdef Q_OS_ANDROID
+    // Nanquim: o Android mata o app bem antes de ele usar metade da RAM.
+    // Com um teto menor, o Krita passa a guardar blocos da imagem no disco
+    // (swap próprio) antes de o sistema fechar o app por falta de memória.
+    const qreal fallback = 35.;
+#else
+    const qreal fallback = 50.;
+#endif
     return !requestDefault ?
-        m_config.readEntry("memoryHardLimitPercent", 50.) : 50.;
+        m_config.readEntry("memoryHardLimitPercent", fallback) : fallback;
 }
 
 void KisImageConfig::setMemoryHardLimitPercent(qreal value)

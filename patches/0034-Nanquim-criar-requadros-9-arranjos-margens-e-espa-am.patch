+                          Kind{"Balão de grito", 2}, Kind{"Caixa de narração", 3}}) {
+        QAction *a = menu->addAction(i18n(k.label));
+        const int kind = k.kind;
+        QObject::connect(a, &QAction::triggered, mw, [mw, kind]() { insertBalloon(mw, kind); });
+    }
+    menu->addSeparator();
+    QAction *text = menu->addAction(i18n("Escrever texto (ferramenta Texto)"));
+    QObject::connect(text, &QAction::triggered, mw, [mw]() { if (QAction *t = act(mw, "SvgTextTool")) t->trigger(); });
+    b->setMenu(menu);
+    b->setPopupMode(QToolButton::InstantPopup);
+    top->addWidget(b);
+}

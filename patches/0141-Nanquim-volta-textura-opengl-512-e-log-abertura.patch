From: Nanquim <nanquim@users.noreply.github.com>
Date: Thu, 26 Nov 2026 22:35:00 -0300
Subject: =?utf-8?q?=5BPATCH=5D_Nanquim=3A_volta_textura_OpenGL_para_512_px_no_Android?=
 =?utf-8?q?_e_adiciona_log_na_abertura?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Desde a build 95 (patches 0137 e 0138), abrir qualquer desenho (.kra ou .png)
parava logo após "Loaded image" com a tela travada na faixa bege do véu de
abertura. O KritaUsageLog confirmou que nenhuma QMessageBox foi trocada pelo
0137/0139 e o único ponto ativo nesse instante foi a volta da textura OpenGL
de 512 px para 256 px (0138).

- Volta o padrão de KisConfig::openGLTextureSize no Android para 512 px (mantendo
  o time-lapse mais calmo do 0138 e a transição do 0140)
- Limpa qualquer textureSize=256 salvo no kritarc, uma vez só, com sync no disco
- Registra no KritaUsageLog o passo a passo de openPageWithFeedback e qualquer
  QMessageBox exibida para diagnóstico rápido caso algum travamento reapareça
---
 libs/ui/NanquimTabletUi.cpp                    |  17 +++++++++++++++++
 libs/ui/kis_config.cc                          |   6 +++---
 2 files changed, 20 insertions(+), 3 deletions(-)

diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -7878,6 +7878,7 @@
     QPointer<KisMainWindow> mwGuard(mw);
     auto close = [veilGuard]() { if (veilGuard) veilGuard->fadeAndClose(); };
     QObject::connect(KisPart::instance(), &KisPart::sigViewAdded, veil, [close, mwGuard](KisView *) {
+        KisUsageLogger::log(QStringLiteral("[Nanquim] abertura: sigViewAdded disparado"));
         QTimer::singleShot(200, close);
         QTimer::singleShot(600, mwGuard.data(), [mwGuard]() { rememberCanvasArea(mwGuard); });
     });
@@ -7887,7 +7888,11 @@
     const int delay = veil->hasGrowth() ? OpeningVeil::GROW_MS + 40 : 60;
     QTimer::singleShot(delay, mw, [mwGuard, path, close]() {
         if (!mwGuard) { close(); return; }
+        KisUsageLogger::log(QStringLiteral("[Nanquim] abertura: iniciando openDocument (%1)")
+                            .arg(QFileInfo(path).fileName()));
         const bool ok = mwGuard->openDocument(path, KisMainWindow::None);
+        KisUsageLogger::log(QStringLiteral("[Nanquim] abertura: openDocument retornou %1")
+                            .arg(ok ? QStringLiteral("ok") : QStringLiteral("falhou")));
         if (!ok) close();
         else QTimer::singleShot(400, mwGuard.data(), close);
     });
@@ -10721,6 +10726,7 @@
         if (box) {
             QMessageBox *mb = static_cast<QMessageBox*>(w);
             dressMessageBox(mb);
+            KisUsageLogger::log(QStringLiteral("[Nanquim] QMessageBox exibida: %1").arg(mb->text().left(160)));
             KisMainWindow *mw = qobject_cast<KisMainWindow*>(parent());
             // caixas com caixa de seleção ou detalhes ficam nativas (são raras)
             // durante a abertura de uma página fica a caixa nativa: a troca nunca pode travar a abertura
@@ -17182,6 +17188,17 @@
             KSharedConfig::openConfig()->sync();
         }
     }
+    // 256 px travou a abertura do canvas OpenGL no Android desde a build 95;
+    // garante volta ao padrão 512 px para quem ficou com 256 gravado no kritarc
+    {
+        KConfigGroup nq = KSharedConfig::openConfig()->group("Nanquim");
+        if (!nq.readEntry("textureSize512Restore", false)) {
+            KConfigGroup general = KSharedConfig::openConfig()->group("");
+            if (general.readEntry("textureSize", 0) == 256) general.deleteEntry("textureSize");
+            nq.writeEntry("textureSize512Restore", true);
+            KSharedConfig::openConfig()->sync();
+        }
+    }
     if (!s_classic) {
         buildColorDock(mw);   // antes da barra: o botão de cor abre este painel
         buildTopBar(mw);
diff --git a/libs/ui/kis_config.cc b/libs/ui/kis_config.cc
--- a/libs/ui/kis_config.cc
+++ b/libs/ui/kis_config.cc
@@ -1146,9 +1146,9 @@
 int KisConfig::openGLTextureSize(bool defaultValue) const
 {
 #ifdef Q_OS_ANDROID
-    // Nanquim: volta aos 256 px do Krita. Com 512 px cada traço fino reenviava
-    // blocos 4x maiores para a GPU e o estabilizador ficava pesado (build 94)
-    const int fallback = 256;
+    // Nanquim: 256 px travou a abertura do canvas OpenGL no Android desde a
+    // build 95 (builds 95-97). Volta para 512 px mantendo o time-lapse calmo.
+    const int fallback = 512;
 #else
     const int fallback = 256;
 #endif

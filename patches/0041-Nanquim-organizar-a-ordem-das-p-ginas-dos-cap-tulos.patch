+    // lembra onde o dedo tocou no cartão, para saber qual seta foi tocada
+    class PressSpy : public QObject {
+    public:
+        using QObject::QObject;
+        bool eventFilter(QObject *obj, QEvent *e) override {
+            if (e->type() == QEvent::MouseButtonRelease || e->type() == QEvent::MouseButtonPress) {
+                obj->setProperty("nanquimLastPos", static_cast<QMouseEvent*>(e)->pos());
+            }
+            return false;
+        }
+    };
+    recents->viewport()->installEventFilter(new PressSpy(recents));
 
-    QObject::connect(recents, &QListView::clicked, mw, [mw, state, removeMode](const QModelIndex &index) {
+    QObject::connect(recents, &QListView::clicked, mw, [mw, state, removeMode, orderMode, recents](const QModelIndex &index) {
         const QString path = index.data(Qt::ToolTipRole).toString();
         if (path.isEmpty()) return;
+        if (orderMode->isChecked() && !state->chapter.isEmpty()) {
+            const QPoint p = recents->viewport()->property("nanquimLastPos").toPoint();
+            const QRect r = recents->visualRect(index);
+            if (p.x() < r.center().x() - r.width() / 6) ChapterStore::instance()->movePage(state->chapter, path, -1);
+            else if (p.x() > r.center().x() + r.width() / 6) ChapterStore::instance()->movePage(state->chapter, path, +1);
+            return;
+        }
         if (state->addMode) {
             ChapterStore::instance()->addPage(state->chapter, path);
             return;

+// toque longo num desenho recente: menu com Abrir / Remover da galeria
+class RecentLongPress : public QObject
+{
+public:
+    RecentLongPress(KisMainWindow *mw, QListView *view)
+        : QObject(view), m_mw(mw), m_view(view)
+    {
+        m_timer.setSingleShot(true);
+        m_timer.setInterval(550);
+        QObject::connect(&m_timer, &QTimer::timeout, this, [this]() { fire(); });
+        view->viewport()->installEventFilter(this);
+    }
+    bool swallowClick()
+    {
+        const bool v = m_fired;
+        m_fired = false;
+        return v;
+    }
+protected:
+    bool eventFilter(QObject *, QEvent *e) override
+    {
+        if (e->type() == QEvent::MouseButtonPress) {
+            m_pos = static_cast<QMouseEvent*>(e)->pos();
+            m_fired = false;
+            m_timer.start();
+        } else if (e->type() == QEvent::MouseMove) {
+            if ((static_cast<QMouseEvent*>(e)->pos() - m_pos).manhattanLength() > 14) m_timer.stop();
+        } else if (e->type() == QEvent::MouseButtonRelease || e->type() == QEvent::Leave) {
+            m_timer.stop();
+        }
+        return false;
+    }
+private:
+    void fire()
+    {
+        const QModelIndex index = m_view->indexAt(m_pos);
+        if (!index.isValid()) return;
+        m_fired = true;
+        const QString path = index.data(Qt::ToolTipRole).toString();
+        QString name = index.data(Qt::DisplayRole).toString();
+        QMenu menu(m_view);
+        QAction *open = menu.addAction(i18n("Abrir"));
+        QAction *remove = menu.addAction(i18n("Remover da galeria"));
+        QAction *chosen = menu.exec(m_view->viewport()->mapToGlobal(m_pos));
+        if (chosen == open) {
+            m_fired = false;
+            m_mw->openDocument(path, KisMainWindow::None);
+        } else if (chosen == remove) {
+            // só tira da lista; o arquivo continua no armazenamento
+            m_mw->removeRecentFile(path);
+        }
+    }
+    KisMainWindow *m_mw;
+    QListView *m_view;
+    QTimer m_timer;
+    QPoint m_pos;
+    bool m_fired = false;
+};

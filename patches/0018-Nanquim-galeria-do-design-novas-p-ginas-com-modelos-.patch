+const QString GALLERY_ID = QStringLiteral("nanquimGallery");
+
+QPixmap renderSvg(const QString &svg, const QSize &logical)
+{
+    const qreal dpr = qApp->devicePixelRatio();
+    QByteArray data = svg.toUtf8();
+    QBuffer buffer(&data);
+    buffer.open(QIODevice::ReadOnly);
+    QImageReader reader(&buffer, "svg");
+    reader.setScaledSize(logical * dpr);
+    QImage image = reader.read();
+    if (image.isNull()) {
+        return QPixmap();
+    }
+    image.setDevicePixelRatio(dpr);
+    return QPixmap::fromImage(image);
+}
+
+const char *DROP_SVG =
+    "<svg xmlns='http://www.w3.org/2000/svg' width='64' height='64' viewBox='0 0 64 64'>"
+    "<defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'>"
+    "<stop offset='0' stop-color='#3d8bff'/><stop offset='1' stop-color='#22d3ee'/></linearGradient></defs>"
+    "<path d='M32 4C40 16 50 27 50 40a18 18 0 0 1-36 0C14 27 24 16 32 4z' fill='url(#g)'/>"
+    "<path d='M32 30v20' stroke='#0d1420' stroke-width='3.2' stroke-linecap='round'/>"
+    "<circle cx='32' cy='27' r='4.2' fill='#0d1420'/></svg>";
+

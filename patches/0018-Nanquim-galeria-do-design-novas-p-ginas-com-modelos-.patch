+QWidget *buildGallery(KisMainWindow *mw)
+{
+    QWidget *gallery = new QWidget();
+    gallery->setObjectName(GALLERY_ID);
+    gallery->setAttribute(Qt::WA_StyledBackground);
+    gallery->setStyleSheet(QLatin1String(GALLERY_STYLE));
+    QVBoxLayout *root = new QVBoxLayout(gallery);
+    root->setContentsMargins(0, 0, 0, 0);
+    root->setSpacing(0);
+
+    // --- cabeçalho -------------------------------------------------------
+    QWidget *header = new QWidget(gallery);
+    header->setObjectName(QStringLiteral("nanquimGalleryHeader"));
+    header->setAttribute(Qt::WA_StyledBackground);
+    header->setFixedHeight(64);
+    QHBoxLayout *hl = new QHBoxLayout(header);
+    hl->setContentsMargins(28, 0, 20, 0);
+    hl->setSpacing(12);
+    QLabel *logo = new QLabel(header);
+    logo->setPixmap(renderSvg(QLatin1String(DROP_SVG), QSize(34, 34)));
+    QLabel *brand = new QLabel(QStringLiteral("Nanquim"), header);
+    brand->setObjectName(QStringLiteral("nanquimBrand"));
+    hl->addWidget(logo);
+    hl->addWidget(brand);
+    hl->addStretch(1);
+
+    QLineEdit *search = new QLineEdit(header);
+    search->setObjectName(QStringLiteral("nanquimSearch"));
+    search->setPlaceholderText(i18n("Buscar desenhos"));
+    search->setClearButtonEnabled(true);
+    search->setFixedWidth(280);
+    hl->addWidget(search);
+
+    QPushButton *back = new QPushButton(i18n("Voltar ao desenho"), header);
+    back->setObjectName(QStringLiteral("nanquimBackToDrawing"));
+    back->setProperty("class", QStringLiteral("nanquimGhost"));
+    back->setFocusPolicy(Qt::NoFocus);
+    QObject::connect(back, &QPushButton::clicked, mw, [mw]() { mw->showWelcomeScreen(false); });
+    hl->addWidget(back);
+
+    QPushButton *open = new QPushButton(i18n("Abrir"), header);
+    open->setProperty("class", QStringLiteral("nanquimGhost"));
+    open->setFocusPolicy(Qt::NoFocus);
+    QObject::connect(open, &QPushButton::clicked, mw, [mw]() {
+        if (QAction *a = act(mw, "file_open")) {
+            a->trigger();
+        }
+    });
+    hl->addWidget(open);
+
+    QToolButton *more = makeMoreButton(mw, header);
+    more->setProperty("class", QStringLiteral("nanquimGhost"));
+    hl->addWidget(more);
+    root->addWidget(header);
+
+    // --- corpo -------------------------------------------------------------
+    QWidget *body = new QWidget(gallery);
+    QVBoxLayout *bl = new QVBoxLayout(body);
+    bl->setContentsMargins(28, 24, 28, 12);
+    bl->setSpacing(14);
+
+    bl->addWidget(sectionLabel(i18n("Nova página"), body));
+    QHBoxLayout *presetsRow = new QHBoxLayout();
+    presetsRow->setSpacing(14);
+    const QList<PagePreset> presets = {
+        {"Página de mangá", "B4 · 600 dpi · 6071 × 8598", 6071, 8598, 600},
+        {"Comic americano", "6,625 × 10,25 pol · 400 dpi", 2650, 4100, 400},
+        {"Tirinha", "4 quadros na horizontal · 300 dpi", 4000, 1250, 300},
+        {"Ilustração", "A4 · 300 dpi · 2480 × 3508", 2480, 3508, 300},
+        {"Personalizado", "Escolha tamanho e resolução", 0, 0, 0},
+    };
+    Q_FOREACH (const PagePreset &p, presets) {
+        QPushButton *card = new QPushButton(body);
+        card->setProperty("class", QStringLiteral("nanquimPreset"));
+        card->setFocusPolicy(Qt::NoFocus);
+        card->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Fixed);
+        QVBoxLayout *cl = new QVBoxLayout(card);
+        cl->setContentsMargins(16, 16, 16, 16);
+        QLabel *n = new QLabel(i18n(p.name), card);
+        n->setObjectName(QStringLiteral("nanquimPresetName"));
+        QLabel *d = new QLabel(i18n(p.detail), card);
+        d->setObjectName(QStringLiteral("nanquimPresetDetail"));
+        d->setWordWrap(true);
+        n->setAttribute(Qt::WA_TransparentForMouseEvents);
+        d->setAttribute(Qt::WA_TransparentForMouseEvents);
+        cl->addWidget(n);
+        cl->addStretch(1);
+        cl->addWidget(d);
+        QObject::connect(card, &QPushButton::clicked, mw, [mw, p]() {
+            if (p.width == 0) {
+                mw->slotFileNew();
+            } else {
+                createPage(p);
+            }
+        });
+        presetsRow->addWidget(card);
+    }
+    bl->addLayout(presetsRow);
+    bl->addSpacing(14);
+
+    bl->addWidget(sectionLabel(i18n("Recentes"), body));
+
+    QSortFilterProxyModel *proxy = new QSortFilterProxyModel(gallery);
+    proxy->setSourceModel(&KisRecentDocumentsModelWrapper::instance()->model());
+    proxy->setFilterCaseSensitivity(Qt::CaseInsensitive);
+    QObject::connect(search, &QLineEdit::textChanged, proxy, &QSortFilterProxyModel::setFilterFixedString);
+
+    QListView *recents = new QListView(body);
+    recents->setObjectName(QStringLiteral("nanquimRecents"));
+    recents->setModel(proxy);
+    recents->setItemDelegate(new RecentDelegate(recents));
+    recents->setViewMode(QListView::IconMode);
+    recents->setResizeMode(QListView::Adjust);
+    recents->setMovement(QListView::Static);
+    recents->setUniformItemSizes(true);
+    recents->setGridSize(RecentDelegate::cell());
+    recents->setSelectionMode(QAbstractItemView::NoSelection);
+    recents->setEditTriggers(QAbstractItemView::NoEditTriggers);
+    recents->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+    recents->setVerticalScrollMode(QAbstractItemView::ScrollPerPixel);
+    recents->setFocusPolicy(Qt::NoFocus);
+    recents->setMouseTracking(false);
+    KisKineticScroller::createPreconfiguredScroller(recents);
+    QObject::connect(recents, &QListView::clicked, mw, [mw](const QModelIndex &index) {
+        const QString path = index.data(Qt::ToolTipRole).toString();
+        if (!path.isEmpty()) {
+            mw->openDocument(path, KisMainWindow::None);
+        }
+    });
+
+    QLabel *empty = new QLabel(i18n("Seus desenhos aparecem aqui. Comece com uma nova página acima."), body);
+    empty->setObjectName(QStringLiteral("nanquimEmpty"));
+    empty->setAlignment(Qt::AlignCenter);
+    auto refreshEmpty = [proxy, empty, recents]() {
+        const bool none = proxy->rowCount() == 0;
+        empty->setVisible(none);
+        recents->setVisible(!none);
+    };
+    QObject::connect(proxy, &QAbstractItemModel::rowsInserted, empty, refreshEmpty);
+    QObject::connect(proxy, &QAbstractItemModel::rowsRemoved, empty, refreshEmpty);
+    QObject::connect(proxy, &QAbstractItemModel::modelReset, empty, refreshEmpty);
+    QObject::connect(proxy, &QAbstractItemModel::layoutChanged, empty, refreshEmpty);
+    refreshEmpty();
+
+    bl->addWidget(recents, 1);
+    bl->addWidget(empty, 1);
+
+    QLabel *footer = new QLabel(i18n("O Nanquim é feito sobre o Krita, software livre da comunidade KDE. "
+                                     "Arte da abertura: Tyson Tan (CC BY-SA)."), body);
+    footer->setObjectName(QStringLiteral("nanquimFooter"));
+    footer->setAlignment(Qt::AlignCenter);
+    bl->addWidget(footer);
+
+    root->addWidget(body, 1);
+    return gallery;
+}
+
+// troca a tela inicial do Krita pela galeria, no mesmo lugar da pilha
+void installGallery(KisMainWindow *mw)
+{
+    QStackedWidget *stack = qobject_cast<QStackedWidget*>(mw->centralWidget());
+    if (!stack || stack->count() < 2) {
+        KisUsageLogger::log(QStringLiteral("[Nanquim] pilha de telas não encontrada; tela inicial do Krita mantida"));
+        return;
+    }
+    const bool wasCurrent = stack->currentIndex() == 0;
+    QWidget *old = stack->widget(0);
+    QWidget *gallery = buildGallery(mw);
+    stack->removeWidget(old);
+    old->hide();
+    stack->insertWidget(0, gallery);
+    if (wasCurrent) {
+        stack->setCurrentIndex(0);
+    }
+}

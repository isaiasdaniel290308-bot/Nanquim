+// miniatura de papel com sombra e o nome embaixo
+class RecentDelegate : public QStyledItemDelegate
+{
+public:
+    using QStyledItemDelegate::QStyledItemDelegate;
+
+    static QSize cell() { return QSize(186, 300); }
+
+    QSize sizeHint(const QStyleOptionViewItem &, const QModelIndex &) const override { return cell(); }
+
+    void paint(QPainter *g, const QStyleOptionViewItem &option, const QModelIndex &index) const override
+    {
+        g->save();
+        g->setRenderHint(QPainter::Antialiasing);
+        g->setRenderHint(QPainter::SmoothPixmapTransform);
+        const QRect r = option.rect.adjusted(9, 6, -9, -6);
+        const int paperW = r.width();
+        const int paperH = qMin(qRound(paperW / 0.707), r.height() - 46);
+        const QRect paper(r.left(), r.top(), paperW, paperH);
+
+        // sombra suave e papel
+        for (int i = 6; i >= 1; --i) {
+            g->setPen(Qt::NoPen);
+            g->setBrush(QColor(0, 0, 0, 10 + 4 * (6 - i)));
+            g->drawRoundedRect(paper.adjusted(-i / 2, i / 2, i / 2, i), 10 + i, 10 + i);
+        }
+        g->setBrush(QColor(0xfa, 0xfa, 0xf7));
+        g->drawRoundedRect(paper, 10, 10);
+
+        const QIcon icon = index.data(Qt::DecorationRole).value<QIcon>();
+        if (!icon.isNull()) {
+            const QRect inner = paper.adjusted(8, 8, -8, -8);
+            const QPixmap pm = icon.pixmap(inner.size());
+            if (!pm.isNull()) {
+                QSize sz = pm.size() / pm.devicePixelRatio();
+                sz.scale(inner.size(), Qt::KeepAspectRatio);
+                const QRect target(QPoint(inner.center().x() - sz.width() / 2, inner.center().y() - sz.height() / 2), sz);
+                g->drawPixmap(target, pm);
+            }
+        }
+        if (option.state & QStyle::State_MouseOver || option.state & QStyle::State_Selected) {
+            g->setPen(QPen(C_ACCENT, 2));
+            g->setBrush(Qt::NoBrush);
+            g->drawRoundedRect(paper, 10, 10);
+        }
+
+        QString name = index.data(Qt::DisplayRole).toString();
+        if (name.endsWith(QLatin1String(".kra"), Qt::CaseInsensitive)) {
+            name.chop(4);
+        }
+        QFont f = option.font;
+        f.setPixelSize(14);
+        f.setWeight(QFont::DemiBold);
+        g->setFont(f);
+        g->setPen(C_TEXT);
+        const QRect textRect(r.left(), paper.bottom() + 10, r.width(), 20);
+        g->drawText(textRect, Qt::AlignLeft | Qt::AlignVCenter,
+                    QFontMetrics(f).elidedText(name, Qt::ElideRight, textRect.width()));
+        g->restore();
+    }
+};
+
+struct PagePreset {
+    const char *name;
+    const char *detail;
+    int width;
+    int height;
+    int dpi;
+};
+
+void createPage(const PagePreset &p)
+{
+    const KoColorSpace *cs = KoColorSpaceRegistry::instance()->rgb8();
+    KisDocument *doc = KisPart::instance()->createDocument();
+    KoColor white(Qt::white, cs);
+    if (!doc->newImage(i18n(p.name), p.width, p.height, cs, white, KisConfig::RASTER_LAYER, 2, QString(), p.dpi / 72.0)) {
+        delete doc;
+        return;
+    }
+    doc->setModified(false);
+    KisPart::instance()->startCustomDocument(doc);
+}
+
+QToolButton *makeMoreButton(KisMainWindow *mw, QWidget *parent)
+{
+    QToolButton *more = new QToolButton(parent);
+    more->setIcon(designIcon(Svg::MORE));
+    more->setIconSize(QSize(22, 22));
+    more->setToolTip(i18n("Mais opções"));
+    more->setFocusPolicy(Qt::NoFocus);
+    QMenu *moreMenu = new QMenu(more);
+    QObject::connect(moreMenu, &QMenu::aboutToShow, mw, [mw, moreMenu]() {
+        moreMenu->clear();
+        Q_FOREACH (QAction *a, mw->menuBar()->actions()) {
+            moreMenu->addAction(a);
+        }
+    });
+    more->setMenu(moreMenu);
+    more->setPopupMode(QToolButton::InstantPopup);
+    return more;
+}
+
+QLabel *sectionLabel(const QString &text, QWidget *parent)
+{
+    QLabel *l = new QLabel(text.toUpper(), parent);
+    l->setObjectName(QStringLiteral("nanquimSection"));
+    return l;
+}

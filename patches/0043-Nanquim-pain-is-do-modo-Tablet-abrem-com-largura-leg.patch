 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
index 5df7aea..b9834a5 100644
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -391,9 +391,22 @@ void togglePanel(KisMainWindow *mw, QDockWidget *dw)
         dw->setFloating(false);
         mw->addDockWidget(Qt::RightDockWidgetArea, dw);
     }
+    // A largura salva pode vir do modo Clássico (coluna estreita de pincéis) e o
+    // resizeDocks é ignorado antes do primeiro layout: por isso a largura mínima
+    // garante o painel legível já na hora, e o ajuste fino vem depois do layout.
+    const int width = qBound(300, mw->width() / 4, 420);
+    dw->setMinimumWidth(300);
     dw->show();
     dw->raise();
-    mw->resizeDocks({dw}, {qBound(300, mw->width() / 4, 420)}, Qt::Horizontal);
+    flushLayouts();
+    mw->resizeDocks({dw}, {width}, Qt::Horizontal);
+    QPointer<QDockWidget> guard(dw);
+    QPointer<KisMainWindow> mwGuard(mw);
+    QTimer::singleShot(0, mw, [guard, mwGuard, width]() {
+        if (guard && mwGuard && guard->isVisible() && guard->width() < width - 20) {
+            mwGuard->resizeDocks({guard.data()}, {width}, Qt::Horizontal);
+        }
+    });
     animateIn(s_panelOverlay, mw, dw, +1, dw->palette().color(QPalette::Window));
 }
 
@@ -4044,6 +4057,7 @@ void arrangeClassic(KisMainWindow *mw)
     }
     Q_FOREACH (QDockWidget *dw, mw->dockWidgets()) {
         dw->hide();
+        dw->setMinimumWidth(0);
     }
     auto place = [mw](const QStringList &ids, Qt::DockWidgetArea area) -> QDockWidget* {
         QDockWidget *dw = findDock(mw, ids);

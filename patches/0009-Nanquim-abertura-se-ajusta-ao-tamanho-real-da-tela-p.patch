@@ -142,29 +136,74 @@ public final class NanquimSplash {
         LinearLayout.LayoutParams cp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
         cp.topMargin = (int) (14 * d);
         right.addView(credit, cp);
-        FrameLayout.LayoutParams rp = new FrameLayout.LayoutParams((int) (w * 0.32f), ViewGroup.LayoutParams.WRAP_CONTENT,
-                Gravity.END | Gravity.CENTER_VERTICAL);
-        rp.rightMargin = side;
-        band.addView(right, rp);
+        band.addView(right, new FrameLayout.LayoutParams(1, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.END | Gravity.CENTER_VERTICAL));
+
+        // Os tamanhos dependem da tela de verdade. No onCreate o Android ainda pode
+        // estar em retrato (a janela só gira para paisagem depois), então tudo que
+        // depende de largura/altura é calculado aqui, a cada mudança de tamanho.
+        root.addOnLayoutChangeListener((v, l, t, r, b, ol, ot, orr, ob) -> {
+            final int w = r - l;
+            final int h = b - t;
+            if (w <= 0 || h <= 0 || (w == orr - ol && h == ob - ot)) {
+                return;
+            }
+            v.post(() -> {
+                final boolean portrait = h > w;
+                final int artH = portrait ? (int) (h * 0.58f) : Math.min(w / 2, (int) (h * 0.74f));
+                final int side = (int) Math.max(32 * d, w * 0.05f);
+
+                setSize(artBox, ViewGroup.LayoutParams.MATCH_PARENT, artH);
+                setSize(fade, ViewGroup.LayoutParams.MATCH_PARENT, (int) (artH * 0.16f));
+                setSize(shine, (int) (Math.max(w, h) * 0.16f), (int) (artH * 1.7f));
+                setSize(band, ViewGroup.LayoutParams.MATCH_PARENT, Math.max(h - artH, (int) (120 * d)));
+
+                FrameLayout.LayoutParams bp = (FrameLayout.LayoutParams) brand.getLayoutParams();
+                FrameLayout.LayoutParams rp = (FrameLayout.LayoutParams) right.getLayoutParams();
+                bp.leftMargin = side;
+                rp.leftMargin = side;
+                rp.rightMargin = side;
+                if (portrait) {
+                    // em pé: logo em cima, carregamento embaixo, os dois à esquerda
+                    bp.gravity = Gravity.START | Gravity.TOP;
+                    bp.topMargin = (int) (28 * d);
+                    rp.width = w - 2 * side;
+                    rp.gravity = Gravity.START | Gravity.BOTTOM;
+                    rp.bottomMargin = (int) (40 * d);
+                } else {
+                    bp.gravity = Gravity.START | Gravity.CENTER_VERTICAL;
+                    bp.topMargin = 0;
+                    rp.width = (int) (w * 0.32f);
+                    rp.gravity = Gravity.END | Gravity.CENTER_VERTICAL;
+                    rp.bottomMargin = 0;
+                }
+                brand.setLayoutParams(bp);
+                right.setLayoutParams(rp);
+
+                // zoom lento com o centro na Kiki e no lótus
+                art.setPivotX(w * 0.30f);
+                art.setPivotY(artH * 0.42f);
+
+                if (sSweep != null) {
+                    sSweep.cancel();
+                }
+                sSweep = ObjectAnimator.ofFloat(shine, "translationX", -0.4f * w, -0.4f * w, 1.3f * w);
+                sSweep.setDuration(5200);
+                sSweep.setInterpolator(new LinearInterpolator());
+                sSweep.setRepeatCount(ValueAnimator.INFINITE);
+                sSweep.setStartDelay(900);
+                sSweep.start();
+            });
+        });
 
         // por cima de tudo: a decorView não é trocada quando o Qt chama setContentView
         ViewGroup decor = (ViewGroup) a.getWindow().getDecorView();
         decor.addView(root, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
         sRoot = root;
 
-        // --- animações ----------------------------------------------------
-        art.setPivotX(w * 0.30f);
-        art.setPivotY(artH * 0.42f);
+        // --- animações que não dependem do tamanho -----------------------
         art.animate().scaleX(1.06f).scaleY(1.06f).translationX(-12 * d)
                 .setDuration(14000).setInterpolator(new DecelerateInterpolator()).start();
 
-        ObjectAnimator sweep = ObjectAnimator.ofFloat(shine, "translationX", -0.4f * w, -0.4f * w, 1.3f * w);
-        sweep.setDuration(5200);
-        sweep.setInterpolator(new LinearInterpolator());
-        sweep.setRepeatCount(ValueAnimator.INFINITE);
-        sweep.setStartDelay(900);
-        sweep.start();
-
         logo.setAlpha(0f);
         logo.setTranslationY(14 * d);
         logo.animate().alpha(1f).translationY(0).setStartDelay(250).setDuration(700).setInterpolator(new DecelerateInterpolator()).start();
@@ -178,6 +217,13 @@ public final class NanquimSplash {
         new Handler(Looper.getMainLooper()).postDelayed(NanquimSplash::hideNow, 90000);
     }
 
+    private static void setSize(View v, int width, int height) {
+        ViewGroup.LayoutParams lp = v.getLayoutParams();
+        lp.width = width;
+        lp.height = height;
+        v.setLayoutParams(lp);
+    }
+
     public static void setStatus(final Activity a, final String text) {
         if (a == null || text == null || text.isEmpty()) {
             return;
@@ -210,6 +256,10 @@ public final class NanquimSplash {
             if (parent != null) {
                 parent.removeView(root);
             }
+            if (sSweep != null) {
+                sSweep.cancel();
+                sSweep = null;
+            }
             sRoot = null;
             sStatus = null;
             sBar = null;

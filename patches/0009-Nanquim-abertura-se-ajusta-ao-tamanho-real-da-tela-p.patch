         brand.setOrientation(LinearLayout.HORIZONTAL);
         brand.setGravity(Gravity.CENTER_VERTICAL);
         final ImageView logo = new ImageView(a);
@@ -112,12 +108,10 @@ public final class NanquimSplash {
         LinearLayout.LayoutParams tp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
         tp.leftMargin = (int) (16 * d);
         brand.addView(texts, tp);
-        FrameLayout.LayoutParams bp = new FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT,
-                Gravity.START | Gravity.CENTER_VERTICAL);
-        bp.leftMargin = side;
-        band.addView(brand, bp);
+        band.addView(brand, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT,
+                Gravity.START | Gravity.CENTER_VERTICAL));
 
-        LinearLayout right = new LinearLayout(a);
+        final LinearLayout right = new LinearLayout(a);
         right.setOrientation(LinearLayout.VERTICAL);
         sStatus = new TextView(a);

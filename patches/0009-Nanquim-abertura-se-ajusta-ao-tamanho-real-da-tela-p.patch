         // --- faixa de baixo -----------------------------------------------
-        FrameLayout band = new FrameLayout(a);
-        root.addView(band, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, Math.max(h - artH, (int) (120 * d)), Gravity.BOTTOM));
-        final int side = (int) (Math.max(32 * d, w * 0.05f));
+        final FrameLayout band = new FrameLayout(a);
+        root.addView(band, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 1, Gravity.BOTTOM));
 

 1 file changed, 83 insertions(+), 33 deletions(-)

diff --git a/packaging/android/apk/src/org/krita/android/NanquimSplash.java b/packaging/android/apk/src/org/krita/android/NanquimSplash.java
index 50e823b..2578353 100644
--- a/packaging/android/apk/src/org/krita/android/NanquimSplash.java
+++ b/packaging/android/apk/src/org/krita/android/NanquimSplash.java
@@ -37,6 +37,7 @@ public final class NanquimSplash {
     private static TextView sStatus;
     private static View sBar;
     private static boolean sHiding;
+    private static ObjectAnimator sSweep;
 
     private NanquimSplash() {}
 
@@ -54,18 +55,15 @@ public final class NanquimSplash {
 
     private static void build(Activity a) {
         DisplayMetrics dm = a.getResources().getDisplayMetrics();
-        final int w = dm.widthPixels;

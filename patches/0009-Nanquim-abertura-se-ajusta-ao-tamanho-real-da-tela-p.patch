+        final FrameLayout root = new FrameLayout(a);
         root.setBackgroundColor(BG);
         root.setClickable(true);   // não deixa toques passarem durante o carregamento
         root.setFocusable(true);
 
         // --- arte ---------------------------------------------------------
-        final int artH = Math.min(w / 2, (int) (h * 0.78f));
-        FrameLayout artBox = new FrameLayout(a);
+        final FrameLayout artBox = new FrameLayout(a);
         artBox.setClipChildren(true);
         final ImageView art = new ImageView(a);
         art.setImageResource(R.drawable.nanquim_splash);
@@ -76,20 +74,18 @@ public final class NanquimSplash {
         shine.setBackground(new GradientDrawable(GradientDrawable.Orientation.LEFT_RIGHT,
                 new int[] {0x00FFFFFF, 0x24FFFFFF, 0x00FFFFFF}));
         shine.setRotation(18f);
-        artBox.addView(shine, new FrameLayout.LayoutParams((int) (w * 0.16f), (int) (artH * 1.7f),
-                Gravity.START | Gravity.CENTER_VERTICAL));
+        artBox.addView(shine, new FrameLayout.LayoutParams(1, 1, Gravity.START | Gravity.CENTER_VERTICAL));
 

+        QtConcurrent::run([projection, bounds, w, h, dir, file, busy]() mutable {
             QImage thumb = projection->createThumbnailUncached(w, h, bounds, 2);
             if (!thumb.isNull()) {
                 QImage frame(w, h, QImage::Format_RGB32);

+ *
+ *  SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#ifndef NANQUIM_TABLET_UI_H
+#define NANQUIM_TABLET_UI_H
+
+class KisMainWindow;
+
+/**
+ * Nanquim: interface de tablet (primeira peça).
+ *
+ * - uma barra só no topo: Arquivo, desfazer/refazer, os controles do pincel do
+ *   Krita, e à direita os painéis Pincéis, Cor, Camadas, Réguas, Referência e Mais;
+ * - os painéis abrem um de cada vez na lateral direita e fecham com outro toque;
+ * - a barra de menus vira o botão "Mais", e as barras padrão do Krita somem;
+ * - toda abertura começa com a tela limpa (só a caixa de ferramentas à esquerda).
+ *
+ * Nada aqui muda os dados ou as ações do Krita: só reorganiza o que já existe.
+ */
+namespace NanquimTabletUi
+{
+void install(KisMainWindow *mainWindow);
+}
+
+#endif

new file mode 100644
index 0000000..a609ec8
--- /dev/null
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -0,0 +1,265 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 Nanquim
+ *
+ *  SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "NanquimTabletUi.h"
+
+#include <QAction>
+#include <QDockWidget>
+#include <QMenu>
+#include <QMenuBar>
+#include <QPointer>
+#include <QTimer>
+#include <QToolBar>
+#include <QToolButton>
+#include <QWidgetAction>
+
+#include <kactioncollection.h>
+#include <ktoolbar.h>
+#include <klocalizedstring.h>
+
+#include "KisMainWindow.h"
+#include "kis_icon_utils.h"
+#include "KisUsageLogger.h"
+
+namespace
+{
+
+// Os painéis que a barra controla, nessa ordem.
+struct Panel {
+    const char *label;
+    const char *icon;
+    QStringList dockIds;   // o primeiro que existir no app
+};
+
+const QString TOOLBOX_ID = QStringLiteral("ToolBox");
+const QString TOOL_OPTIONS_ID = QStringLiteral("sharedtooldocker");
+const char *PANEL_PROPERTY = "nanquimPanel";
+
+QList<Panel> panels()
+{
+    return {
+        {"Pincéis", "krita_tool_freehand", {QStringLiteral("PresetDocker")}},
+        {"Cor", "extended_color_selector", {QStringLiteral("WideGamutColorSelector"), QStringLiteral("ColorSelectorNg")}},
+        {"Camadas", "all-layers", {QStringLiteral("KisLayerBox")}},
+    };
+}
+
+QDockWidget *findDock(KisMainWindow *mw, const QStringList &ids)
+{
+    Q_FOREACH (const QString &id, ids) {
+        if (QDockWidget *dw = mw->dockWidget(id)) {
+            return dw;
+        }
+    }
+    return nullptr;
+}
+
+const char *STYLE =
+    "QToolBar#BrushesAndStuff { background: #0d1320; border: none; border-bottom: 1px solid #1c2535;"
+    "  spacing: 4px; padding: 2px 6px; }"
+    "QToolBar#BrushesAndStuff QToolButton { border: 1px solid transparent; border-radius: 9px;"
+    "  padding: 3px 7px; color: #cfe0f2; }"
+    "QToolBar#BrushesAndStuff QToolButton:pressed { background: #1c2535; }"
+    "QToolBar#BrushesAndStuff QToolButton[nanquimPanel=\"true\"]:checked {"
+    "  background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #3d8bff, stop:1 #22d3ee);"
+    "  color: #0b1019; }"
+    "QToolBar#BrushesAndStuff QToolButton::menu-indicator { image: none; width: 0px; }";
+
+QToolButton *makeButton(QToolBar *bar, const QString &text, const char *icon, bool underIcon)
+{
+    QToolButton *b = new QToolButton(bar);
+    b->setText(text);
+    b->setToolTip(text);
+    b->setIcon(KisIconUtils::loadIcon(QLatin1String(icon)));
+    b->setToolButtonStyle(underIcon ? Qt::ToolButtonTextUnderIcon : Qt::ToolButtonIconOnly);
+    b->setAutoRaise(true);
+    b->setFocusPolicy(Qt::NoFocus);
+    return b;
+}
+
+void hideStockToolbars(KisMainWindow *mw)
+{
+    Q_FOREACH (KisToolBar *tb, mw->toolBars()) {
+        if (tb->objectName() != QLatin1String("BrushesAndStuff")) {
+            tb->setVisible(false);
+        }
+    }
+    mw->menuBar()->setVisible(false);
+}
+
+// Toca num painel: abre ele na lateral direita e fecha os outros da barra.
+void togglePanel(KisMainWindow *mw, QDockWidget *dw, const QList<QPointer<QDockWidget>> &all)
+{
+    if (!dw) {
+        return;
+    }
+    if (dw->isVisible()) {
+        dw->hide();
+        return;
+    }
+    Q_FOREACH (const QPointer<QDockWidget> &other, all) {
+        if (other && other != dw) {
+            other->hide();
+        }
+    }
+    if (dw->isFloating() || mw->dockWidgetArea(dw) != Qt::RightDockWidgetArea) {
+        dw->setFloating(false);
+        mw->addDockWidget(Qt::RightDockWidgetArea, dw);
+    }
+    dw->show();
+    dw->raise();
+    // largura confortável para o dedo, sem engolir a tela
+    mw->resizeDocks({dw}, {qBound(300, mw->width() / 4, 420)}, Qt::Horizontal);
+}
+
+} // namespace
+
+void NanquimTabletUi::install(KisMainWindow *mw)
+{
+    auto *ac = mw->actionCollection();
+    KisToolBar *bar = mw->toolBar(QStringLiteral("BrushesAndStuff"));
+    if (!bar) {
+        KisUsageLogger::log(QStringLiteral("[Nanquim] barra BrushesAndStuff não encontrada; interface padrão mantida"));
+        return;
+    }
+
+    // --- a barra única ---------------------------------------------------
+    bar->setMovable(false);
+    bar->setFloatable(false);
+    bar->setStyleSheet(QLatin1String(STYLE));
+    bar->setIconSize(QSize(22, 22));
+
+    // tira o que pesa e quase não se usa no tablet
+    const QStringList hiddenActions = {
+        QStringLiteral("gradients"), QStringLiteral("patterns"),
+        QStringLiteral("select_layout"), QStringLiteral("workspaces"),
+    };
+    Q_FOREACH (const QString &name, hiddenActions) {
+        if (QAction *a = ac->action(name)) {
+            bar->removeAction(a);
+        }
+    }
+
+    // --- esquerda: Arquivo, desfazer, refazer ----------------------------
+    QAction *first = bar->actions().isEmpty() ? nullptr : bar->actions().first();
+
+    QToolButton *fileButton = makeButton(bar, i18n("Arquivo"), "document-open", false);
+    QMenu *fileMenu = new QMenu(fileButton);
+    const QStringList fileActions = {
+        QStringLiteral("file_new"), QStringLiteral("file_open"), QStringLiteral("file_open_recent"),
+        QString(),
+        QStringLiteral("file_save"), QStringLiteral("file_save_as"), QStringLiteral("file_export_file"),
+        QString(),
+        QStringLiteral("file_import_file"),
+    };
+    Q_FOREACH (const QString &name, fileActions) {
+        if (name.isEmpty()) {
+            fileMenu->addSeparator();
+        } else if (QAction *a = ac->action(name)) {
+            fileMenu->addAction(a);
+        }
+    }
+    fileButton->setMenu(fileMenu);
+    fileButton->setPopupMode(QToolButton::InstantPopup);
+    bar->insertWidget(first, fileButton);
+
+    for (const char *name : {"edit_undo", "edit_redo"}) {
+        if (QAction *a = ac->action(QLatin1String(name))) {
+            bar->insertAction(first, a);
+        }
+    }
+    bar->insertSeparator(first);
+
+    // --- direita: os painéis --------------------------------------------
+    // (o espaçador do Krita já empurra o que vem depois para a direita)
+    QList<QPointer<QDockWidget>> managed;
+    QList<QPair<QToolButton*, QDockWidget*>> buttons;
+    Q_FOREACH (const Panel &p, panels()) {
+        QDockWidget *dw = findDock(mw, p.dockIds);
+        if (!dw) {
+            continue;
+        }
+        managed << dw;
+        QToolButton *b = makeButton(bar, i18n(p.label), p.icon, true);
+        b->setCheckable(true);
+        b->setProperty(PANEL_PROPERTY, true);
+        bar->addWidget(b);
+        buttons << qMakePair(b, dw);
+    }
+    for (const auto &pair : buttons) {
+        QToolButton *b = pair.first;
+        QDockWidget *dw = pair.second;
+        QObject::connect(b, &QToolButton::clicked, mw, [mw, dw, managed, b]() {
+            togglePanel(mw, dw, managed);
+            b->setChecked(dw->isVisible());
+        });
+        QObject::connect(dw->toggleViewAction(), &QAction::toggled, b, [b](bool on) {
+            b->setChecked(on);
+        });
+    }
+
+    // Réguas e requadros: a ferramenta de assistentes e os atalhos de régua
+    QToolButton *rulers = makeButton(bar, i18n("Réguas"), "krita_tool_assistant", true);
+    QMenu *rulerMenu = new QMenu(rulers);
+    for (const char *name : {"KisAssistantTool", "KritaShape/KisToolMeasure", "toggle_assistant",
+                             "view_toggle_painting_assistants", "view_toggle_assistant_previews",
+                             "view_grid", "view_snap_to_grid"}) {
+        if (QAction *a = ac->action(QLatin1String(name))) {
+            rulerMenu->addAction(a);
+        }
+    }
+    rulers->setMenu(rulerMenu);
+    rulers->setPopupMode(QToolButton::InstantPopup);
+    bar->addWidget(rulers);
+
+    // Referência: ferramenta de imagens de referência
+    if (QAction *ref = ac->action(QStringLiteral("ToolReferenceImages"))) {
+        QToolButton *refButton = makeButton(bar, i18n("Referência"), "krita_tool_reference_images", true);
+        QObject::connect(refButton, &QToolButton::clicked, ref, &QAction::trigger);
+        bar->addWidget(refButton);
+    }
+
+    // Mais: o menu completo do Krita, montado na hora de abrir
+    QToolButton *more = makeButton(bar, i18n("Mais"), "hamburger_menu_dots", true);
+    QMenu *moreMenu = new QMenu(more);
+    QObject::connect(moreMenu, &QMenu::aboutToShow, mw, [mw, moreMenu]() {
+        moreMenu->clear();
+        Q_FOREACH (QAction *a, mw->menuBar()->actions()) {
+            moreMenu->addAction(a);
+        }
+    });
+    more->setMenu(moreMenu);
+    more->setPopupMode(QToolButton::InstantPopup);
+    bar->addWidget(more);
+
+    // --- tela limpa ------------------------------------------------------
+    // Painéis fechados não se redesenham, então isso também deixa o app mais leve.
+    Q_FOREACH (QDockWidget *dw, mw->dockWidgets()) {
+        const QString id = dw->objectName();
+        if (id != TOOLBOX_ID && id != TOOL_OPTIONS_ID) {
+            dw->hide();
+        }
+    }
+
+    hideStockToolbars(mw);
+    bar->setVisible(true);
+
+    // O Krita restaura o estado das barras ao terminar de montar a janela;
+    // repete depois disso para a barra de menus e as barras padrão ficarem escondidas.
+    QPointer<KisMainWindow> guard(mw);
+    QTimer::singleShot(0, mw, [guard]() {
+        if (guard) {
+            hideStockToolbars(guard);
+        }
+    });
+    QObject::connect(mw, &KisMainWindow::guiLoadingFinished, mw, [guard]() {
+        if (guard) {
+            hideStockToolbars(guard);
+        }
+    });
+
+    KisUsageLogger::log(QStringLiteral("[Nanquim] interface de tablet instalada"));
+}

From 5061dbcbfafc842060d492879590b075eda66b27 Mon Sep 17 00:00:00 2001
From: Nanquim <nanquim@users.noreply.github.com>
Date: Thu, 26 Nov 2026 16:45:00 -0300
Subject: [PATCH] Nanquim: abrir desenho não trava mais na folha bege

Na build 95, abrir qualquer desenho deixava a tela escura com uma faixa bege no topo.
Uma caixa do Krita aparecia durante a abertura e a folha que a substitui (0137) colocava
o texto numa área de rolagem sem fundo próprio: ela saía bege, o texto claro sumia e a
abertura ficava esperando a resposta, presa atrás do véu "Abrindo…".
- O texto vai direto na folha, no fundo escuro dela (sem área de rolagem)
- Enquanto uma página abre, a caixa do Krita fica nativa: a troca nunca trava a abertura
- O texto de cada caixa trocada vai para o KritaUsageLog, para saber qual caixa era

Claude-Session: https://claude.ai/code/session_012fwRUYPpG2prvZV1MLpuhj
---
 libs/ui/NanquimTabletUi.cpp | 36 ++++++++++++------------------------
 1 file changed, 12 insertions(+), 24 deletions(-)

diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -10439,6 +10439,7 @@ void replaceMessageBox(QPointer<QMessageBox> mb, QPointer<KisMainWindow> mw)
 {
     if (!mb || !mw || mb->property("nanquimReplacing").toBool()) return;
     mb->setProperty("nanquimReplacing", true);
+    KisUsageLogger::log(QStringLiteral("[Nanquim] caixa do Krita trocada por folha: %1").arg(mb->text().left(160)));
 
     auto prepare = [](QString t) {
         if (Qt::mightBeRichText(t)) return t;
@@ -10467,37 +10468,22 @@ void replaceMessageBox(QPointer<QMessageBox> mb, QPointer<KisMainWindow> mw)
         top->addWidget(icon, 0, Qt::AlignTop);
     }
 
-    // Área de texto rolável para mensagens longas não empurrarem os botões para fora da tela
-    QScrollArea *scroll = new QScrollArea(d);
-    scroll->setWidgetResizable(true);
-    scroll->setFrameShape(QFrame::NoFrame);
-    scroll->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
-    scroll->setProperty("nanquimSmooth", true);
-    tuneSmoothScroller(KisKineticScroller::createPreconfiguredScroller(scroll));
-
-    QWidget *textsHost = new QWidget(scroll);
-    textsHost->setStyleSheet(QStringLiteral("background: transparent;"));
-    QVBoxLayout *texts = new QVBoxLayout(textsHost);
-    texts->setContentsMargins(0, 0, 4, 0);
+    // Texto direto na folha, no fundo escuro dela. A versão com área de rolagem
+    // deixava o fundo da rolagem bege (cor de papel do tema) e o texto claro sumia;
+    // ao abrir uma página, a folha ficava presa atrás do véu "Abrindo…".
+    QVBoxLayout *texts = new QVBoxLayout();
     texts->setSpacing(6);
-
-    QLabel *main = nqLabel(prepare(mb->text()), "nqItem", textsHost, true);
+    QLabel *main = nqLabel(prepare(mb->text()), "nqItem", d, true);
     main->setTextFormat(mb->textFormat());
     main->setMinimumWidth(0);
+    main->setTextInteractionFlags(Qt::NoTextInteraction);
     texts->addWidget(main);
     if (!mb->informativeText().isEmpty()) {
-        QLabel *info = nqLabel(prepare(mb->informativeText()), "nqSmall", textsHost, true);
+        QLabel *info = nqLabel(prepare(mb->informativeText()), "nqSmall", d, true);
         info->setMinimumWidth(0);
         texts->addWidget(info);
     }
-    scroll->setWidget(textsHost);
-
-    const int availW = qMax(180, d->width() - 48 - (hasIcon ? 58 : 0));
-    const int wantedH = texts->hasHeightForWidth() ? texts->heightForWidth(availW) : textsHost->sizeHint().height();
-    const int maxScrollH = qMax(120, mw->height() - 190);
-    scroll->setFixedHeight(qBound(24, wantedH + 4, maxScrollH));
-
-    top->addWidget(scroll, 1);
+    top->addLayout(texts, 1);
     root->addLayout(top);
 
     auto chosen = std::make_shared<QPointer<QAbstractButton>>();
@@ -10562,7 +10548,9 @@ protected:
             dressMessageBox(mb);
             KisMainWindow *mw = qobject_cast<KisMainWindow*>(parent());
             // caixas com caixa de seleção ou detalhes ficam nativas (são raras)
-            if (mw && !mb->checkBox() && mb->detailedText().isEmpty() && !mb->buttons().isEmpty()
+            // durante a abertura de uma página fica a caixa nativa: a troca nunca pode travar a abertura
+            const bool opening = mw && mw->findChild<QWidget*>(QStringLiteral("nanquimOpeningVeil"));
+            if (mw && !opening && !mb->checkBox() && mb->detailedText().isEmpty() && !mb->buttons().isEmpty()
                     && !mb->property("nanquimReplacing").toBool()) {
                 mb->setWindowOpacity(0.0);
                 mb->resize(1, 1);
-- 

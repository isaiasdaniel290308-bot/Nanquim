+namespace {
+// Nanquim: abrir um pincel (.kpp) ou pacote (.bundle) instala o recurso,
+// em vez de tentar abri-lo como imagem. Usado quando o arquivo chega pelo
+// "Abrir com" do Android ou pela linha de comando.
+bool nanquimImportResourceFile(QWidget *parent, const QString &url)
+{
+    QString path = url;
+    if (path.startsWith(QStringLiteral("file://"))) {
+        path = QUrl(path).toLocalFile();
+    }
+    const QFileInfo info(path);
+    const QString suffix = info.suffix().toLower();
+    if (suffix != QStringLiteral("kpp") && suffix != QStringLiteral("bundle")) {
+        return false;
+    }
+    if (!info.exists()) {
+        return false;
+    }
+
+    if (suffix == QStringLiteral("kpp")) {
+        KoResourceSP resource = KisResourceUserOperations::importResourceFileWithUserInput(
+            parent, QString(), ResourceType::PaintOpPresets, path);
+        if (resource) {
+            QMessageBox::information(parent, QStringLiteral("Nanquim"),
+                                     QStringLiteral("Pincel importado: %1").arg(resource->name()));
+        }
+        KisUsageLogger::log(QStringLiteral("[Nanquim] Import .kpp %1: %2").arg(info.fileName()).arg(resource ? "ok" : "falhou"));
+        return true;
+    }
+
+    const bool ok = KisStorageModel::instance()->importStorage(path, KisStorageModel::None);
+    QMessageBox::information(parent, QStringLiteral("Nanquim"),
+                             ok ? QStringLiteral("Pacote importado: %1\nOs pincéis já estão na biblioteca.").arg(info.fileName())
+                                : QStringLiteral("Não foi possível importar %1.\nTalvez ele já esteja instalado, ou o arquivo não é um pacote do Krita válido.").arg(info.fileName()));
+    KisUsageLogger::log(QStringLiteral("[Nanquim] Import .bundle %1: %2").arg(info.fileName()).arg(ok ? "ok" : "falhou"));
+    return true;
+}
+}
+
 void KisApplication::fileOpenRequested(const QString &url)
 {
     if (!d->mainWindow) {
@@ -1132,6 +1182,10 @@ void KisApplication::fileOpenRequested(const QString &url)
         return;
     }
 
+    if (nanquimImportResourceFile(d->mainWindow, url)) {
+        return;
+    }
+
     KisMainWindow::OpenFlags flags = d->batchRun ? KisMainWindow::BatchMode : KisMainWindow::None;
     d->mainWindow->openDocument(url, flags);
 }

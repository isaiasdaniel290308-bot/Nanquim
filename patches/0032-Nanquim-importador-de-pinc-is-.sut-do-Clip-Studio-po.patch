+/*
+ *  SPDX-FileCopyrightText: 2026 Nanquim
+ *
+ *  SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#ifndef NANQUIM_SUT_IMPORT_H
+#define NANQUIM_SUT_IMPORT_H
+
+#include <QString>
+
+class QWidget;
+
+/**
+ * Nanquim: importa uma subferramenta do Clip Studio Paint (.sut) como pincel
+ * do Krita. O .sut é um banco SQLite; a ponta vem da miniatura PNG guardada
+ * no material (até 300 px). O traço fica parecido, não idêntico: curvas de
+ * pressão e textura de papel ainda não são convertidas.
+ */
+namespace NanquimSutImport
+{
+// devolve true se o pincel foi criado; "message" recebe o texto para o usuário
+bool importFile(QWidget *parent, const QString &path, QString *message);
+}
+
+#endif

+            final float s = Math.max(W / VW, H / VH);
+            final float ox = Math.min(0, Math.max(W - VW * s, W / 2f - 760 * s));
+            final float oy = (H - VH * s) / 2;
+            // marca e rodapé seguem as bordas da tela
+            final float cs = Math.min(W / VW, H / VH);
+
+            // ---- a onda (depois que o app carregou) ----
+            updateWave(t);
+
+            if (!baseHidden) {
+                final float tt = Math.min(t, 7000);          // a introdução fica parada no fim
+                final float shx = kf(tt, LINEAR, 1112, 0, 1144, -9, 1184, 8, 1224, -5, 1264, 3, 1320, 0);
+                final float shy = kf(tt, LINEAR, 1112, 0, 1144, 5, 1184, -6, 1224, 3, 1264, -2, 1320, 0);
+                c.drawColor(0xFF05070B);

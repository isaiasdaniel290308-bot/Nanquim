+        private void updateWave(float t) {
+            if (finishAt < 0) return;
+            // espera a marca terminar de entrar antes de chamar a onda
+            float go = Math.max(finishAt, 2600) + 250;
+            if (t < go) return;
+            if (waveIdx < 0) {
+                if (wave.get(0) == null) return;
+                waveIdx = 0;
+                waveNext = (long) (t + WAVE_MS);
+                return;
+            }
+            while (t >= waveNext) {
+                if (waveIdx + 1 >= WAVE_N) {
+                    waveIdx = WAVE_N;
+                    removeSelf();
+                    return;
+                }
+                if (wave.get(waveIdx + 1) == null) {
+                    waveNext = (long) t;     // quadro ainda não está pronto: segura o atual
+                    return;
+                }
+                wave.set(waveIdx, null);
+                waveIdx++;
+                waveNext += (long) WAVE_MS;
+                if (waveIdx == 7) bumpAt = (long) t;
+                if (waveIdx >= WAVE_COVER && !baseHidden) {
+                    // a onda cobre tudo: daqui em diante só ela, com a tela inicial por baixo
+                    baseHidden = true;
+                    setClickable(false);
+                    setFocusable(false);
+                    bg = kiki = kikiBlink = null;
+                }
+            }
+        }

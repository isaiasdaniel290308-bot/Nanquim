+                ring(c, h - 15, 2, col, .35f * a);
+            } else {
+                circle(c, h, col, .6f * a);
+                circle(c, h * .44f, 0xFFFFFFFF, .5f * a);
+            }
+        }
+
+        private static void hexagon(Path p, float h) {
+            p.moveTo(-h * .5f, -h * .92f); p.lineTo(h * .5f, -h * .92f); p.lineTo(h, 0);
+            p.lineTo(h * .5f, h * .92f); p.lineTo(-h * .5f, h * .92f); p.lineTo(-h, 0); p.close();
+        }

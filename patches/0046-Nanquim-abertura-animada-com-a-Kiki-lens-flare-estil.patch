+        private void drawGhost(Canvas c, int kind, float d, int col, float a) {
+            float h = d / 2;
+            a = Math.max(0, Math.min(1, a));
+            if (kind == 1) {
+                Path p = tmp;
+                p.reset();
+                hexagon(p, h);
+                pFx.setColor(col);
+                pFx.setAlpha((int) (255 * .5f * a));
+                c.drawPath(p, pFx);
+                p.reset();
+                hexagon(p, h * .64f);
+                pFx.setAlpha((int) (255 * .4f * a));
+                c.drawPath(p, pFx);
+            } else if (kind == 2) {

From 1aede1759b6dbafec5588ee19845c603f93af87d Mon Sep 17 00:00:00 2001
From: Nanquim <nanquim@local>
Date: Fri, 27 Nov 2026 22:17:32 +0000
Subject: [PATCH] Nanquim: identidade, abertura nativa Android e versionCode

Adiciona nome, icone gota-pena, splash nativa Java, intent-filters de importacao (.kpp/.bundle/.sut/.zip) e mantem versionCode acima da build 100 (5050400) para atualizar sem desinstalar.
---
 krita/data/splash/splash-android.qrc          | 13 +++
 libs/ui/kis_splash_screen.cpp                 | 12 +++
 packaging/android/apk/AndroidManifest.xml     | 71 ++++++++++++++-
 packaging/android/apk/build.gradle            |  5 +-
 .../apk/flavors/next/AndroidManifest.xml      |  5 +-
 .../drawable/ic_launcher_next_background.xml  | 65 +------------
 .../drawable/ic_launcher_next_foreground.xml  | 91 ++++---------------
 .../src/org/krita/android/MainActivity.java   | 13 +++
 8 files changed, 136 insertions(+), 139 deletions(-)

diff --git a/krita/data/splash/splash-android.qrc b/krita/data/splash/splash-android.qrc
index d7147ad4ee..610767b1ea 100644
--- a/krita/data/splash/splash-android.qrc
+++ b/krita/data/splash/splash-android.qrc
@@ -7,6 +7,19 @@
     <qresource prefix="/splash">
         <file>banner.svg</file>
         <file alias="hd.jpg">electrichearts_20250824A_kiki_HD.jpg</file>
+        <file>nanquim-logo.svg</file>
+        <file>nanquim-banner.svg</file>
+        <!-- Nanquim: Montserrat (SIL Open Font License), baixada pelo CI -->
+        <file>fonts/Montserrat-Regular.ttf</file>
+        <file>fonts/Montserrat-Medium.ttf</file>
+        <file>fonts/Montserrat-SemiBold.ttf</file>
+        <file>fonts/Montserrat-Bold.ttf</file>
+        <!-- Nanquim: fonte da interface (Satoshi, ou Montserrat se o download falhar) -->
+        <file>fonts/ui-regular.otf</file>
+        <file>fonts/ui-medium.otf</file>
+        <file>fonts/ui-bold.otf</file>
+        <!-- Nanquim: marca NANQUIM (Chillax Bold, ou Montserrat Bold se o download falhar) -->
+        <file>fonts/brand-bold.otf</file>
     </qresource>
 </RCC>
 
diff --git a/libs/ui/kis_splash_screen.cpp b/libs/ui/kis_splash_screen.cpp
index 2bcfff5760..98df062b0e 100644
--- a/libs/ui/kis_splash_screen.cpp
+++ b/libs/ui/kis_splash_screen.cpp
@@ -58,8 +58,14 @@ KisSplashScreen::KisSplashScreen(bool themed, QWidget *parent, Qt::WindowFlags f
     m_loadingTextLabel->setAlignment(Qt::AlignRight | Qt::AlignTop);
     addDropShadow(m_loadingTextLabel);
 
+#ifdef Q_OS_ANDROID
+    // Nanquim: logo e nome próprios na abertura do app
+    m_brandingSvg = new QSvgWidget(QStringLiteral(":/splash/nanquim-logo.svg"), lblSplash);
+    m_bannerSvg = new QSvgWidget(QStringLiteral(":/splash/nanquim-banner.svg"), lblSplash);
+#else
     m_brandingSvg = new QSvgWidget(QStringLiteral(":/krita-branding.svgz"), lblSplash);
     m_bannerSvg = new QSvgWidget(QStringLiteral(":/splash/banner.svg"), lblSplash);
+#endif
     addDropShadow(m_bannerSvg);
 
     m_artCreditsLabel = new QLabel(lblSplash);
@@ -290,9 +296,15 @@ KisSplashScreen::Source KisSplashScreen::getImageSource()
     }
 #endif
 #endif
+#ifdef Q_OS_ANDROID
+    // Nanquim: arte do Tyson Tan para o Krita, licenciada em CC BY-SA e GNU GPL
+    // (https://krita.org/en/about/mascot/).
+    artistCredit = QStringLiteral("Arte: Tyson Tan (CC BY-SA) · Nanquim, feito sobre o Krita");
+#else
     if (!artistCredit.isEmpty()) {
         artistCredit = i18nc("splash image credit", "Artwork by: %1", artistCredit);
     }
+#endif
     return Source{resourcePath, artistCredit};
 }
 

@@ -221,7 +221,10 @@ android {
 
         targetSdkVersion 36
         minSdkVersion 24
-        versionCode project.ext.constant * 1000000 + versionMajor * 10000 + versionMinor * 100 + versionRelease
+        // Nanquim: versionCode acima da build 100 (5.4 = 5050400) para atualizar sem desinstalar
+        def nanquimBuildEnv = System.getenv('NANQUIM_BUILD_NUMBER')
+        def nanquimBuildNum = (nanquimBuildEnv && nanquimBuildEnv.isInteger()) ? nanquimBuildEnv.toInteger() : 1
+        versionCode 5050500 + nanquimBuildNum
         versionName project.ext.props['versionString']
         def unstableSuffix = System.getenv('KRITA_UNSTABLE_PACKAGE_SUFFIX')
         archivesBaseName = System.getenv('KRITA_BUILD_APPBUNDLE') ? "krita-$versionName$unstableSuffix" : "krita-$abi-$versionName$unstableSuffix"

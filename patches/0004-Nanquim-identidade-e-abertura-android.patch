diff --git a/packaging/android/apk/src/org/krita/android/MainActivity.java b/packaging/android/apk/src/org/krita/android/MainActivity.java
index 093be86d51..e80f7c3c9f 100644
--- a/packaging/android/apk/src/org/krita/android/MainActivity.java
+++ b/packaging/android/apk/src/org/krita/android/MainActivity.java
@@ -67,6 +67,7 @@ public class MainActivity extends QtActivity {
         SDLAudioManager.nativeSetupJNI();
 
         super.onCreate(savedInstanceState);
+        NanquimSplash.show(this);
         Log.i(TAG, "TouchSlop: " + ViewConfiguration.get(this).getScaledTouchSlop());
         Log.i(TAG, "LibsLoaded");
         haveLibsLoaded = true;
@@ -105,8 +106,16 @@ public class MainActivity extends QtActivity {
 
     private String getUri(Intent intent) {
         if (intent != null) {
+            String imported = intent.getStringExtra(NanquimImport.EXTRA_PATH);
+            if (imported != null) {
+                return imported;
+            }
             Uri fileUri = intent.getData();
             if (fileUri != null) {
+                String localResource = NanquimImport.copyResourceFileIfNeeded(this, fileUri);
+                if (localResource != null) {
+                    return localResource;
+                }
                 return fileUri.toString();
             }
         }
@@ -386,6 +395,9 @@ public class MainActivity extends QtActivity {
     public static void setLoaded(boolean loaded) {
         Log.d(TAG, "setLoaded " + loaded);
         applicationLoaded = loaded;
+        if (loaded) {
+            NanquimSplash.hide(QtNative.activity());
+        }
         updateDonationDialog();
     }
 
@@ -393,6 +405,7 @@ public class MainActivity extends QtActivity {
     public static void setLoadingText(String loadingText) {
         Log.d(TAG, "setLoadingText " + loadingText);
         applicationLoadingText = loadingText;
+        NanquimSplash.setStatus(QtNative.activity(), loadingText);
         updateDonationDialog();
     }
 

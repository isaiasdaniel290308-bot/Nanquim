diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
index b5989ca..fdbc243 100644
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -36,7 +36,7 @@ QList<Panel> panels()
 {
     return {
         {"Pincéis", "krita_tool_freehand", {QStringLiteral("PresetDocker")}},
-        {"Cor", "extended_color_selector", {QStringLiteral("WideGamutColorSelector"), QStringLiteral("ColorSelectorNg")}},
+        {"Cor", "extended_color_selector", {QStringLiteral("ColorSelectorNg"), QStringLiteral("WideGamutColorSelector")}},
         {"Camadas", "all-layers", {QStringLiteral("KisLayerBox")}},
         {"Opções", "configure", {QStringLiteral("sharedtooldocker")}},
     };
@@ -100,11 +100,19 @@ void togglePanel(KisMainWindow *mw, QDockWidget *dw, const QList<QPointer<QDockW
         dw->hide();
         return;
     }
-    Q_FOREACH (const QPointer<QDockWidget> &other, all) {
-        if (other && other != dw) {
+    Q_UNUSED(all);
+    // um painel de cada vez: fecha qualquer outro aberto (menos a caixa de
+    // ferramentas), inclusive painéis abertos pelo menu "Mais"
+    Q_FOREACH (QDockWidget *other, mw->dockWidgets()) {
+        if (other != dw && other->objectName() != TOOLBOX_ID && other->isVisible()) {
             other->hide();
         }
     }
+    // se o painel estava empilhado em abas com outros, solta ele sozinho
+    if (!mw->tabifiedDockWidgets(dw).isEmpty()) {
+        mw->removeDockWidget(dw);
+        mw->addDockWidget(Qt::RightDockWidgetArea, dw);
+    }
     if (dw->isFloating() || mw->dockWidgetArea(dw) != Qt::RightDockWidgetArea) {
         dw->setFloating(false);
         mw->addDockWidget(Qt::RightDockWidgetArea, dw);

 #include "KoToolFactoryBase.h"
 
 #include "KoToolBase.h"
@@ -48,13 +49,16 @@ QList<QAction *> KoToolFactoryBase::createActions(KisKActionCollection *actionCo
 {
     QList<QAction *> toolActions;
 
+    NanquimStepTimer nanquimTimer(QStringLiteral("ferramenta ") + id());
     KisActionRegistry *actionRegistry = KisActionRegistry::instance();
     QList<QAction*> actions = createActionsImpl(toolManager);
+    nanquimTimer.mark(QStringLiteral("criar acoes (createActionsImpl)"), 40);
     QAction *action = actionRegistry->makeQAction(id(), this);
     actionCollection->addAction(id(), action);
     connect(action, &QAction::triggered, toolManager, [toolId = id(), toolManager] () {
         toolManager->switchToolRequested(toolId);
     });
+    nanquimTimer.mark(QStringLiteral("acao da ferramenta"), 40);
 
     Q_FOREACH(QAction *action, actions) {
         if (action->objectName().isEmpty()) {
@@ -123,6 +127,8 @@ QList<QAction *> KoToolFactoryBase::createActions(KisKActionCollection *actionCo
     }
 #endif
 
+    nanquimTimer.mark(QStringLiteral("registrar acoes"), 40);

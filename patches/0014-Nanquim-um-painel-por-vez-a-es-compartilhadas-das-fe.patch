diff --git a/libs/ui/tool/KisToolPaintFactoryBase.cpp b/libs/ui/tool/KisToolPaintFactoryBase.cpp
index 73f8474..4ff64db 100644
--- a/libs/ui/tool/KisToolPaintFactoryBase.cpp
+++ b/libs/ui/tool/KisToolPaintFactoryBase.cpp
@@ -5,6 +5,7 @@
  */
 #include "KisToolPaintFactoryBase.h"
 
+#include <QAction>
 #include <kis_action_registry.h>
 #include <kis_action.h>
 
@@ -23,6 +24,27 @@ QList<QAction *> KisToolPaintFactoryBase::createActionsImpl(KoToolManager *toolM
 {
     Q_UNUSED(toolManager);
 
+#ifdef Q_OS_ANDROID
+    // Nanquim: cada ferramenta de pintura recriava (traduzia, configurava e
+    // depois descartava) as mesmas 6 ações compartilhadas. No Android só existe
+    // uma janela, então da segunda ferramenta em diante basta devolver ações
+    // "marcadoras" com o mesmo nome: KoToolFactoryBase::createActions encontra
+    // a ação de verdade na coleção, apaga a marcadora e só anota a ferramenta.
+    static bool s_sharedActionsCreated = false;
+    if (s_sharedActionsCreated) {
+        QList<QAction *> placeholders;
+        for (const char *name : {"increase_brush_size", "decrease_brush_size",
+                                 "rotate_brush_tip_clockwise", "rotate_brush_tip_clockwise_precise",
+                                 "rotate_brush_tip_counter_clockwise", "rotate_brush_tip_counter_clockwise_precise"}) {
+            QAction *placeholder = new QAction(this);
+            placeholder->setObjectName(QLatin1String(name));
+            placeholders << placeholder;
+        }
+        return placeholders;
+    }
+    s_sharedActionsCreated = true;
+#endif
+
     KisActionRegistry *actionRegistry = KisActionRegistry::instance();
     QList<QAction *> actions;
 

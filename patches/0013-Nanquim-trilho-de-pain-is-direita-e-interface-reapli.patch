+void NanquimTabletUi::install(KisMainWindow *mw)
+{
+    KisToolBar *bar = nullptr;
+    Q_FOREACH (KisToolBar *tb, mw->toolBars()) {
+        if (tb->objectName() == TOP_BAR_ID) {
+            bar = tb;
         }
     }
+    if (!bar) {
+        KisUsageLogger::log(QStringLiteral("[Nanquim] barra BrushesAndStuff não encontrada; interface padrão mantida"));
+        return;
+    }
+    setupTopBar(mw, bar);
+    createRail(mw);
+    KisUsageLogger::log(QStringLiteral("[Nanquim] interface de tablet instalada"));
+}
 
-    hideStockToolbars(mw);
-    bar->setVisible(true);
+void NanquimTabletUi::applyLayout(KisMainWindow *mw, bool canvasMode)
+{
+    QToolBar *rail = mw->findChild<QToolBar*>(RAIL_ID);
+    if (!rail) {
+        return;   // install() não rodou: deixa o Krita como está
+    }
 
-    // O Krita restaura o estado das barras ao terminar de montar a janela;
-    // repete depois disso para a barra de menus e as barras padrão ficarem escondidas.
-    QPointer<KisMainWindow> guard(mw);
-    QTimer::singleShot(0, mw, [guard]() {
-        if (guard) {
-            hideStockToolbars(guard);
+    mw->menuBar()->setVisible(false);
+
+    if (canvasMode) {
+        // só a barra do topo do Nanquim; as barras padrão do Krita somem
+        Q_FOREACH (KisToolBar *tb, mw->toolBars()) {
+            tb->setVisible(tb->objectName() == TOP_BAR_ID);
         }
-    });
-    QObject::connect(mw, &KisMainWindow::guiLoadingFinished, mw, [guard]() {
-        if (guard) {
-            hideStockToolbars(guard);
+    }
+    rail->setVisible(true);
+    Q_FOREACH (QToolButton *b, rail->findChildren<QToolButton*>()) {
+        if (b->property(NEEDS_CANVAS).toBool()) {
+            b->setEnabled(canvasMode);
         }
-    });
+    }
 
-    KisUsageLogger::log(QStringLiteral("[Nanquim] interface de tablet instalada"));
+    // A primeira tela de desenho da sessão começa limpa. Painel fechado não se
+    // redesenha, então isso também deixa o app mais leve. Depois disso, o que o
+    // usuário abrir fica aberto (o Krita salva e restaura).
+    if (canvasMode && !s_canvasCleaned) {
+        s_canvasCleaned = true;
+        Q_FOREACH (QDockWidget *dw, mw->dockWidgets()) {
+            const QString id = dw->objectName();
+            if (id != TOOLBOX_ID) {
+                dw->hide();
+            }
+        }
+    }
 }
diff --git a/libs/ui/NanquimTabletUi.h b/libs/ui/NanquimTabletUi.h
index 2b7a09f..ec4af65 100644
--- a/libs/ui/NanquimTabletUi.h
+++ b/libs/ui/NanquimTabletUi.h
@@ -12,17 +12,22 @@ class KisMainWindow;
 /**
  * Nanquim: interface de tablet (primeira peça).
  *
- * - uma barra só no topo: Arquivo, desfazer/refazer, os controles do pincel do
- *   Krita, e à direita os painéis Pincéis, Cor, Camadas, Réguas, Referência e Mais;
- * - os painéis abrem um de cada vez na lateral direita e fecham com outro toque;
+ * - barra do topo: Arquivo, desfazer/refazer e os controles do pincel do Krita;
+ * - trilho vertical à direita: Pincéis, Cor, Camadas, Opções, Réguas, Referência e Mais;
+ * - os painéis abrem um de cada vez ao lado do trilho e fecham com outro toque;
  * - a barra de menus vira o botão "Mais", e as barras padrão do Krita somem;
- * - toda abertura começa com a tela limpa (só a caixa de ferramentas à esquerda).
+ * - a primeira tela de desenho da sessão começa limpa (só a caixa de ferramentas).
  *
  * Nada aqui muda os dados ou as ações do Krita: só reorganiza o que já existe.
  */
 namespace NanquimTabletUi
 {
+// monta a barra e o trilho (uma vez, no fim do construtor da janela)
 void install(KisMainWindow *mainWindow);
+
+// reaplica o arranjo depois que o Krita troca entre a tela inicial e a de desenho
+// (o Krita restaura menus, barras e painéis salvos nessas trocas)
+void applyLayout(KisMainWindow *mainWindow, bool canvasMode);
 }
 
 #endif

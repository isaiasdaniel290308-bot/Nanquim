+// --- animações ---------------------------------------------------------------
+// O Krita desliga as animações nativas de painéis no Android (eram lentas e
+// davam crash). Aqui a animação é feita por cima: uma camada leve, que não
+// recebe toques, desenha uma "foto" do painel deslizando e aparecendo. O painel
+// de verdade já está no lugar por baixo, então nada é redimensionado a cada
+// quadro e a tela de desenho não é recalculada durante a animação.
+
+class NanquimOverlay : public QWidget
+{
+public:
+    using Painter = std::function<void(QPainter &, const QRect &, qreal)>;
+
+    NanquimOverlay(QWidget *parent, const QRect &geometry, Painter painter)
+        : QWidget(parent)
+        , m_painter(std::move(painter))
+    {
+        setAttribute(Qt::WA_TransparentForMouseEvents);
+        setAttribute(Qt::WA_NoSystemBackground);
+        setFocusPolicy(Qt::NoFocus);
+        setGeometry(geometry);
+        raise();
+        show();
+    }
+
+    void setProgress(qreal p)
+    {
+        m_progress = p;
+        update();
+    }
+
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter g(this);
+        g.setRenderHint(QPainter::SmoothPixmapTransform);
+        m_painter(g, rect(), m_progress);
+    }
+
+private:
+    Painter m_painter;
+    qreal m_progress = 0.0;
+};
+
+QPointer<NanquimOverlay> s_panelOverlay;
+QPointer<NanquimOverlay> s_screenOverlay;
+
+void runOverlay(QPointer<NanquimOverlay> &slot, NanquimOverlay *overlay, int durationMs, QEasingCurve::Type easing)
+{
+    if (slot) {
+        slot->deleteLater();
+    }
+    slot = overlay;
+    QVariantAnimation *anim = new QVariantAnimation(overlay);
+    anim->setStartValue(0.0);
+    anim->setEndValue(1.0);
+    anim->setDuration(durationMs);
+    anim->setEasingCurve(easing);
+    QObject::connect(anim, &QVariantAnimation::valueChanged, overlay, [overlay](const QVariant &v) {
+        overlay->setProgress(v.toReal());
+    });
+    QObject::connect(anim, &QVariantAnimation::finished, overlay, &QObject::deleteLater);
+    anim->start();
+}
+
+// aplica já o layout pendente, para saber a posição final do painel antes de desenhar
+void flushLayouts()
+{
+    QApplication::sendPostedEvents(nullptr, QEvent::LayoutRequest);
+}
+
+const int SLIDE_DP = 56;
+
+void animatePanelIn(KisMainWindow *mw, QDockWidget *dw)
+{
+    flushLayouts();
+    const QRect geom = dw->geometry();
+    if (geom.isEmpty()) {
+        return;
+    }
+    const QPixmap shot = dw->grab();
+    const QColor bg = dw->palette().color(QPalette::Window);
+    NanquimOverlay *o = new NanquimOverlay(mw, geom, [shot, bg](QPainter &g, const QRect &r, qreal p) {
+        // fundo do painel firme; o conteúdo entra da direita e aparece
+        g.fillRect(r, bg);
+        g.setOpacity(p);
+        g.drawPixmap(QPointF((1.0 - p) * SLIDE_DP, 0), shot);
+    });
+    runOverlay(s_panelOverlay, o, 240, QEasingCurve::OutCubic);
+}
+
+void animatePanelOut(KisMainWindow *mw, const QRect &geom, const QPixmap &shot)
+{
+    if (geom.isEmpty() || shot.isNull()) {
+        return;
+    }
+    flushLayouts();
+    NanquimOverlay *o = new NanquimOverlay(mw, geom, [shot](QPainter &g, const QRect &, qreal p) {
+        // o painel sai para a direita e se dissolve sobre o desenho
+        g.setOpacity(1.0 - p);
+        g.drawPixmap(QPointF(p * SLIDE_DP, 0), shot);
+    });
+    runOverlay(s_panelOverlay, o, 190, QEasingCurve::InCubic);
+}
+
+// troca de tela (inicial <-> desenho): a nova tela surge de um fundo escuro
+void animateScreenIn(KisMainWindow *mw)
+{
+    QWidget *central = mw->centralWidget();
+    if (!central) {
+        return;
+    }
+    const QRect geom(central->mapTo(mw, QPoint(0, 0)), central->size());
+    NanquimOverlay *o = new NanquimOverlay(mw, geom, [](QPainter &g, const QRect &r, qreal p) {
+        g.fillRect(r, QColor(11, 16, 25, int(255 * (1.0 - p))));
+    });
+    runOverlay(s_screenOverlay, o, 320, QEasingCurve::OutCubic);
+}
+
 QToolButton *makeButton(QWidget *parent, const QString &text, const char *icon, Qt::ToolButtonStyle style)
 {
     QToolButton *b = new QToolButton(parent);
@@ -97,7 +220,10 @@ void togglePanel(KisMainWindow *mw, QDockWidget *dw, const QList<QPointer<QDockW
         return;
     }
     if (dw->isVisible()) {
+        const QRect geom = dw->geometry();
+        const QPixmap shot = dw->grab();
         dw->hide();
+        animatePanelOut(mw, geom, shot);
         return;
     }
     Q_UNUSED(all);
@@ -121,6 +247,7 @@ void togglePanel(KisMainWindow *mw, QDockWidget *dw, const QList<QPointer<QDockW
     dw->raise();
     // largura confortável para o dedo, sem engolir a tela
     mw->resizeDocks({dw}, {qBound(300, mw->width() / 4, 420)}, Qt::Horizontal);
+    animatePanelIn(mw, dw);
 }
 
 void setupTopBar(KisMainWindow *mw, KisToolBar *bar)
@@ -292,6 +419,12 @@ void NanquimTabletUi::applyLayout(KisMainWindow *mw, bool canvasMode)
 
     mw->menuBar()->setVisible(false);
 
+    // anima só quando a tela muda de verdade (a primeira vez é coberta pela abertura)
+    static int s_lastMode = -1;
+    const int mode = canvasMode ? 1 : 0;
+    const bool screenChanged = s_lastMode != -1 && s_lastMode != mode;
+    s_lastMode = mode;
+
     if (canvasMode) {
         // só a barra do topo do Nanquim; as barras padrão do Krita somem
         Q_FOREACH (KisToolBar *tb, mw->toolBars()) {
@@ -317,4 +450,9 @@ void NanquimTabletUi::applyLayout(KisMainWindow *mw, bool canvasMode)
             }
         }
     }
+
+    if (screenChanged) {
+        flushLayouts();
+        animateScreenIn(mw);
+    }
 }

diff --git a/libs/ui/KisApplication.cpp b/libs/ui/KisApplication.cpp
index d863380..1018dd7 100644
--- a/libs/ui/KisApplication.cpp
+++ b/libs/ui/KisApplication.cpp
@@ -561,6 +561,15 @@ bool KisApplication::start(const KisApplicationArguments &args)
 #endif
 
     KConfigGroup group(KSharedConfig::openConfig(), "theme");
+#ifdef Q_OS_ANDROID
+    // Nanquim: tema escuro azul do design, aplicado uma vez (depois vale a escolha do usuário
+    // em Configurações → Tema)
+    if (!group.readEntry("nanquimThemeV1", false)) {
+        group.writeEntry("Theme", "Nanquim");
+        group.writeEntry("nanquimThemeV1", true);
+        group.sync();
+    }
+#endif
 #ifndef Q_OS_HAIKU
     Digikam::ThemeManager themeManager;
     themeManager.setCurrentTheme(group.readEntry("Theme", "Krita dark"));
diff --git a/libs/ui/kis_config.cc b/libs/ui/kis_config.cc
index db19491..468ea1e 100644
--- a/libs/ui/kis_config.cc
+++ b/libs/ui/kis_config.cc
@@ -1346,7 +1346,11 @@ void KisConfig::setScrollingCheckers(bool sc) const
 
 QColor KisConfig::canvasBorderColor(bool defaultValue) const
 {
+#ifdef Q_OS_ANDROID
+    QColor color(QColor(43, 43, 49));   // Nanquim: fundo da área de desenho do design
+#else
     QColor color(QColor(128,128,128));
+#endif
     return (defaultValue ? color : m_cfg.readEntry("canvasBorderColor", color));
 }
 

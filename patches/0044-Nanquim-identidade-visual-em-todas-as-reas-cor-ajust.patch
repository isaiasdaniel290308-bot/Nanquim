+        "(Landroid/app/Activity;Ljava/lang/String;Ljava/lang/String;)V",
+        QtAndroid::androidActivity().object(),
+        QAndroidJniObject::fromString(uri).object<jstring>(),
+        QAndroidJniObject::fromString(mime).object<jstring>());
+#else
+    Q_UNUSED(uri);
+    Q_UNUSED(mime);
+#endif
+}

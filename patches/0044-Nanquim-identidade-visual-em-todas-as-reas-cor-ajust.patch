+class MessageStyler : public QObject
+{
+public:
+    using QObject::QObject;
+protected:
+    bool eventFilter(QObject *obj, QEvent *e) override
+    {
+        if (e->type() != QEvent::Polish) return false;
+        QWidget *w = qobject_cast<QWidget*>(obj);
+        if (!w || !w->isWindow() || w->property("nanquimStyled").toBool()) return false;
+        if (!w->inherits("QMessageBox") && !w->inherits("QInputDialog")) return false;
+        w->setProperty("nanquimStyled", true);
+        if (w->styleSheet().isEmpty()) w->setStyleSheet(QLatin1String(MESSAGE_STYLE));
+        return false;
+    }
+};

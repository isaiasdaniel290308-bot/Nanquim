+    qint64 currentBytes() const
+    {
+        const QString dir = currentDir();
+        qint64 total = 0;
+        if (!dir.isEmpty()) {
+            Q_FOREACH (const QFileInfo &info, QDir(dir).entryInfoList({QStringLiteral("frame_*.jpg")}, QDir::Files)) {

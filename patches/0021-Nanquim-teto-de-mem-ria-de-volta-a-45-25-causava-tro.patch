Subject: [PATCH] =?UTF-8?q?Nanquim:=20teto=20de=20mem=C3=B3ria=20de=20volt?=
 =?UTF-8?q?a=20a=2045%=20(25%=20causava=20troca=20com=20o=20disco=20ao=20t?=
 =?UTF-8?q?ransformar)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 libs/image/kis_image_config.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/libs/image/kis_image_config.cpp b/libs/image/kis_image_config.cpp
index fc6ddaa..cca3dd5 100644
--- a/libs/image/kis_image_config.cpp
+++ b/libs/image/kis_image_config.cpp
@@ -198,8 +198,10 @@ qreal KisImageConfig::memoryHardLimitPercent(bool requestDefault) const
     // Nanquim: o Android mata o app bem antes de ele usar metade da RAM.
     // Com um teto menor, o Krita passa a guardar blocos da imagem no disco
     // (swap próprio) antes de o sistema fechar o app por falta de memória.
-    // (25%: desenhos muito grandes, de 1-2 GiB, eram fechados pelo sistema com 35%)
-    const qreal fallback = 25.;
+    // Testes no Tab S10 Lite: 25% fazia o Krita trocar dados com o disco no meio
+    // do transformar/liquidificar (lento) e não salvava os desenhos de 1-2 GiB
+    // de qualquer forma. 45% fica perto do padrão do Krita, com um pouco de folga.
+    const qreal fallback = 45.;
 #else
     const qreal fallback = 50.;
 #endif

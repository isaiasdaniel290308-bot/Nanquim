diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
index 524bf4a..02909b2 100644
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -845,7 +845,9 @@ protected:
         if (e->type() != QEvent::Show) return false;
         QWidget *w = qobject_cast<QWidget*>(obj);
         if (!w || !w->isWindow() || w->windowType() != Qt::Popup) return false;
-        if (w->inherits("QComboBoxPrivateContainer") || w->property("nanquimAnimating").toBool()) return false;
+        // só menus: as janelas de pincéis do Krita se posicionam depois de aparecer,
+        // e animar a posição delas as jogava para o canto da tela
+        if (!w->inherits("QMenu") || w->property("nanquimAnimating").toBool()) return false;
         const QPoint end = w->pos();
         QPropertyAnimation *anim = new QPropertyAnimation(w, "pos", w);
         anim->setDuration(160);

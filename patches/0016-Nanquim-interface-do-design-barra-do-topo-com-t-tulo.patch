+            const QRect geom(nav->mapTo(mw, QPoint(0, 0)), nav->size());
+            const QPixmap shot = nav->grab();
+            nav->hide();
+            animateOut(s_navOverlay, mw, geom, shot, -1);
+        } else {
+            nav->hide();
+        }
+        if (tab) {
+            flushLayouts();
+            positionExpandTab(mw, tab);
+            tab->show();
+            tab->raise();
+        }
+    } else {
+        if (tab) {
+            tab->hide();
+        }
+        if (!nav->isVisible()) {
+            nav->show();
+            if (animate) {
+                animateIn(s_navOverlay, mw, nav, -1, C_NAV);
+            }
